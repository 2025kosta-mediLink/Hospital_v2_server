### environments
@base = {{host}}/waiting

############################################################
### 1. 의사별 오늘의 대기 목록 조회
############################################################
GET {{base}}/doctor/1/today
Accept: application/json
Cookie: {{cookie}}

> {%
    client.test("today waiting list ok", function () {
        client.assert(response.status === 200, "200 expected");
        const list = response.body?.data;
        if (list && list.length > 0) {
            client.log("📋 오늘 대기 인원: " + list.length + "명");
            client.log("첫 번째 대기: " + JSON.stringify(list[0]));
        } else {
            client.log("⚠️ 오늘 대기 중인 환자가 없습니다");
        }
    });
%}

############################################################
### 2. 환자 호출 (특정 대기표)
############################################################
POST {{base}}/call
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "ticketId": 1
}

> {%
    client.test("call patient ok", function () {
        client.assert(response.status === 200, "200 expected");
        const data = response.body?.data;
        client.assert(data && data.status === "CALLED", "status should be CALLED");
        client.log("✅ 환자 호출 완료: 대기번호 " + data.queueNo);
    });
%}

############################################################
### 3. 다음 대기자 자동 호출
############################################################
POST {{base}}/doctor/1/call-next
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

> {%
    client.test("call next patient ok", function () {
        client.assert(response.status === 200, "200 expected");
        const data = response.body?.data;
        client.log("✅ 다음 환자 호출: 대기번호 " + data.queueNo);
    });
%}

############################################################
### 4. 대기 상태 업데이트 (진료 시작)
############################################################
PATCH {{base}}/1/status
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "status": "IN_SERVICE"
}

############################################################
### 5. 대기 상태 업데이트 (진료 완료)
############################################################
PATCH {{base}}/1/status
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "status": "DONE"
}

############################################################
### 6. 환자가 본인 대기 현황 조회
############################################################
GET {{base}}/reception/1
Accept: application/json
Cookie: {{cookie}}

> {%
    client.test("patient waiting status ok", function () {
        client.assert(response.status === 200, "200 expected");
        const data = response.body?.data;
        client.log("🎫 내 대기번호: " + data.queueNo);
        client.log("⏰ 예상 대기시간: " + data.estimatedWaitMinutes + "분");
        client.log("👥 앞 대기 인원: " + data.waitingCount + "명");
    });
%}