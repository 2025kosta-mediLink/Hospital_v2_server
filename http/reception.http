### environments
@base = {{host}}/receptions
@reservationBase = {{host}}/reservation

############################################################
### 1. 접수 생성 (DIRECT) → receptionId 저장
############################################################
POST {{base}}
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "doctorId": 1,
  "symptomIds": [1, 2],
  "noteToDoctor": "테스트: 기침/두통 2일 지속",
  "consentNotice": true
}

> {%
    client.test("create reception ok", function () {
        client.assert(response.status === 201 || response.status === 200, "201 or 200 expected");
        const data = response.body?.data;
        client.assert(data && (data.receptionId || data.id), "receptionId should be in ApiResponse.data");
        const rid = data.receptionId || data.id;
        client.global.set("receptionId", rid);
        client.log("receptionId = " + rid);
    });
%}

############################################################
### 2. 접수 상세(단건) 조회
############################################################
GET {{base}}/{{receptionId}}
Accept: application/json
Cookie: {{cookie}}

> {%
    client.test("reception detail ok", function () {
        client.assert(response.status === 200, "200 expected");
        const d = response.body?.data;
        client.assert(d && d.receptionId, "detail.receptionId required");
        client.assert(!!d.status, "status required");
        client.log("receptionNo = " + d.receptionNo + ", status = " + d.status);
    });
%}

############################################################
### 3.1 내 전체 접수 리스트 (필터 없음)
############################################################
GET {{base}}/list
Accept: application/json
Cookie: {{cookie}}

############################################################
### 3.2 내 접수 리스트 (2025년 11월, 전체 상태)
############################################################
GET {{base}}/list?year=2025&month=11
Accept: application/json
Cookie: {{cookie}}

############################################################
### 3.3 내 접수 리스트 (2025년 11월, WAITING만)
############################################################
GET {{base}}/list?year=2025&month=11&status=WAITING
Accept: application/json
Cookie: {{cookie}}

############################################################
### 4.1 접수 취소
############################################################
POST {{base}}/{{receptionId}}/cancel
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "reason": "테스트 취소"
}

> {%
    client.test("cancel ok", function () {
        client.assert(response.status === 200, "200 expected");
    });
%}

############################################################
### 4.2 취소 반영 확인 (상세 재조회 → CANCELLED)
############################################################
GET {{base}}/{{receptionId}}
Accept: application/json
Cookie: {{cookie}}

> {%
    client.test("cancelled detail ok", function () {
        client.assert(response.status === 200, "200 expected");
        const d = response.body?.data;
        client.assert(d && d.status, "status required");
        client.assert(d.status === "CANCELLED", "status should be CANCELLED");
    });
%}

############################################################
### 5. 오늘의 예약 목록 조회 (기존)
############################################################
GET {{reservationBase}}/today
Accept: application/json
Cookie: {{cookie}}

############################################################
### 6. 오늘 예약 → 접수 생성 (예약 기반 접수)
############################################################
POST {{base}}/from-reservation
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "reservationId": 56,
  "symptomIds": [1, 2],
  "noteToDoctor": "어제부터 두통, 미열",
  "consentNotice": true
}

> {%
    client.test("reception from reservation ok", function () {
        client.assert(response.status === 201 || response.status === 200, "201 or 200 expected");
        const data = response.body?.data;
        client.assert(data && (data.receptionId || data.id), "receptionId should be in ApiResponse.data");
        const rid = data.receptionId || data.id;
        client.global.set("receptionIdFromReservation", rid);
        client.log("receptionId(from reservation) = " + rid);
    });
%}