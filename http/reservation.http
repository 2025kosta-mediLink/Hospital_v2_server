### environments
@base = {{host}}/reservation

############################################################
### 1. 날짜별 예약 가능 시간 조회
############################################################
GET {{base}}/doctor/1/available-times?date=2025-11-20
Accept: application/json

############################################################
### 2. 예약 생성
############################################################
POST {{base}}
Content-Type: application/json
Accept: application/json
Cookie: {{cookie}}

{
  "doctorId": 3,
  "reservationTime": "2025-11-02T09:30:00"
}

############################################################
### 3. 예약 단건 조회
############################################################
GET {{base}}/82
Accept: application/json
Cookie: {{cookie}}

############################################################
### 4.1 내 전체 예약 리스트 (필터 없음)
############################################################
GET {{base}}/list
Accept: application/json
Cookie: {{cookie}}

############################################################
### 4.2 내 예약 리스트 (2025년 1월, 전체 상태)
############################################################
GET {{base}}/list?year=2025&month=11
Accept: application/json
Cookie: {{cookie}}

############################################################
### 4.3 내 예약 리스트 (2025년 1월, RESERVED만)
############################################################
GET {{base}}/list?year=2025&month=11&status=CANCELLED
Accept: application/json
Cookie: {{cookie}}